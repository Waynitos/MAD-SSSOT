{
  "$schema": "https://tokens.studio/schema/2.0",
  "version": "1.0",
  "description": "Phewphonics 3D Design Studio — brand tokens in Tokens Studio format. Source of truth: PLU-branding-extended.md. Install Tokens Studio plugin in Figma and point at this file to auto-sync brand tokens.",
  "source": "https://raw.githubusercontent.com/Waynitos/MAD-SSSOT/main/PLU-branding-extended.md",
  "last-updated": "2026-10-25",

  "global": {
    "color": {
      "primary": {
        "value": "#4B2FA0",
        "type": "color",
        "description": "Brand purple — main logo colour, CTA buttons, headings"
      },
      "primary-dark": {
        "value": "#3A2280",
        "type": "color",
        "description": "Darker purple — hover states"
      },
      "primary-light": {
        "value": "#6B4FC8",
        "type": "color",
        "description": "Lighter purple — highlights, links"
      },
      "accent": {
        "value": "#7B5ED4",
        "type": "color",
        "description": "Mid-purple — active states, badges, tags"
      },
      "white": {
        "value": "#FFFFFF",
        "type": "color"
      },
      "neutral-dark": {
        "value": "#333333",
        "type": "color",
        "description": "Near-black text"
      },
      "neutral-mid": {
        "value": "#666666",
        "type": "color",
        "description": "Secondary text, captions"
      },
      "neutral-light": {
        "value": "#CCCCCC",
        "type": "color",
        "description": "Borders, dividers"
      },
      "bg-light": {
        "value": "#F5F5F7",
        "type": "color",
        "description": "Off-white page background"
      },
      "bg-dark": {
        "value": "#1A1020",
        "type": "color",
        "description": "Deep purple-tinted dark mode background"
      },
      "card": {
        "value": "#FFFFFF",
        "type": "color"
      },
      "card-dark": {
        "value": "#2A1E40",
        "type": "color",
        "description": "Dark mode card — purple-tinted"
      }
    },
    "typography": {
      "font-display": {
        "value": "Bauhaus 93",
        "type": "fontFamily",
        "description": "Confirmed wordmark font. Not on Google Fonts — embed as woff2 or use system install. Fallback: Nunito 700/800"
      },
      "font-display-fallback": {
        "value": "Nunito",
        "type": "fontFamily",
        "description": "Web fallback when Bauhaus 93 unavailable"
      },
      "font-subtitle": {
        "value": "Rajdhani",
        "type": "fontFamily",
        "description": "Tight spaced caps — matches 3D DESIGN STUDIO subtitle treatment. Load via Google Fonts weight 600+700"
      },
      "font-subtitle-alt": {
        "value": "Barlow Condensed",
        "type": "fontFamily"
      },
      "font-body": {
        "value": "-apple-system, BlinkMacSystemFont, Segoe UI, Nunito, sans-serif",
        "type": "fontFamily"
      },
      "size-display": {
        "value": "clamp(2rem, 5vw, 4rem)",
        "type": "fontSize"
      },
      "size-h1": {
        "value": "clamp(1.5rem, 3vw, 2.5rem)",
        "type": "fontSize"
      },
      "size-h2": {
        "value": "1.5rem",
        "type": "fontSize"
      },
      "size-body": {
        "value": "1rem",
        "type": "fontSize"
      },
      "size-small": {
        "value": "0.875rem",
        "type": "fontSize"
      },
      "size-subtitle": {
        "value": "0.75rem",
        "type": "fontSize",
        "description": "For 3D DESIGN STUDIO-style uppercase labels"
      },
      "letter-spacing-subtitle": {
        "value": "0.12em",
        "type": "letterSpacing"
      }
    },
    "spacing": {
      "unit": {
        "value": "8px",
        "type": "spacing"
      },
      "gutter": {
        "value": "16px",
        "type": "spacing"
      },
      "gutter-lg": {
        "value": "24px",
        "type": "spacing"
      },
      "section-gap": {
        "value": "48px",
        "type": "spacing"
      }
    },
    "border-radius": {
      "default": {
        "value": "12px",
        "type": "borderRadius"
      },
      "sm": {
        "value": "6px",
        "type": "borderRadius"
      },
      "pill": {
        "value": "999px",
        "type": "borderRadius",
        "description": "Pill/capsule shape — primary button style"
      }
    },
    "shadow": {
      "card": {
        "value": "0 2px 8px rgba(75,47,160,0.08)",
        "type": "boxShadow"
      }
    }
  },

  "print": {
    "description": "CMYK equivalents for print. See print-specs.md for full bleed/trim/safe zone specs.",
    "color": {
      "primary-cmyk": {
        "value": "C:67 M:80 Y:0 K:0",
        "type": "color",
        "description": "CMYK approximate for #4B2FA0. Verify with print bureau — actual Pantone 2685 C recommended for spot colour jobs"
      },
      "primary-pantone": {
        "value": "Pantone 2685 C",
        "type": "color",
        "description": "Closest Pantone to brand purple — use for single-colour/spot-colour print jobs"
      },
      "white-cmyk": {
        "value": "C:0 M:0 Y:0 K:0",
        "type": "color"
      },
      "black-cmyk": {
        "value": "C:0 M:0 Y:0 K:100",
        "type": "color",
        "description": "Rich black: C:40 M:30 Y:30 K:100 for large solid areas"
      }
    }
  }
}
