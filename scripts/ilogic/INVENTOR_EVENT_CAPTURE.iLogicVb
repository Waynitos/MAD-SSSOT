'' =====================================================================
'' INVENTOR_EVENT_CAPTURE.iLogicVb
''
'' Hooks CommandManager.CommandEvents.OnCommand and writes every
'' Inventor command ID to a Desktop log file + the iLogic Logger.
'' Run once to START, run again to STOP.
''
'' WHY CommandEvents (not ApplicationEvents):
''   ApplicationEvents.OnOpenDocument requires ByRef HandlingCode in
''   the delegate signature, which cannot be used in iLogic lambdas and
''   causes "Statement not valid in namespace" when defined as outer-scope
''   Subs.  CommandEvents.OnCommand has no ByRef parameter — the Private
''   Sub pattern works cleanly.
''
'' WHAT TO DO:
''   1. Run this rule → "CAPTURE ACTIVE" dialog appears.
''   2. In Inventor, perform the operations you want to identify:
''        - Right-click an occurrence → Replace Component
''        - In a drawing → Update Model Reference
''        - Save, Save As, etc.
''   3. Watch the iLogic Logger pane OR open the Desktop log in Notepad.
''   4. Run the rule AGAIN → capture stops, log path shown.
''
'' WHAT THE LOG TELLS YOU:
''   Each line = one Inventor command ID.  For example:
''     AssemblyReplaceComponentCmd   ← Replace Component in assembly
''     DrawingDocumentUpdateCmd      ← Update drawing model reference
''   Those IDs are the ground truth for what iLogic must trigger/replicate.
''
'' iLogic COMPILER RULES (hard-won from compile errors):
''   - Do NOT add Imports System.IO or Imports System.Windows.Forms
''     (pre-imported; duplicates cause Inventor.File / System.IO.File ambiguity)
''   - Do NOT add Imports Inventor (pre-imported; would conflict)
''   - Do NOT place bare Dim at outer scope (only Sub/Function/Class valid there)
''   - Private Sub OUTSIDE Sub Main() works for CommandEvents handlers
''   - Use System.IO.File / System.IO.Path fully qualified throughout
''
'' Last updated: 2026-11-04 fix4 — rewrote to use CommandManager.CommandEvents
'' =====================================================================

' ── Desktop sentinel path ───────────────────────────────────────────
' (Function at outer scope is valid in iLogic)
Function SentinelPath() As String
    Return System.IO.Path.Combine(
        System.Environment.GetFolderPath(System.Environment.SpecialFolder.Desktop),
        "INVENTOR_CAPTURE_ACTIVE.flag")
End Function

' ── Event handler — fires for EVERY Inventor command ────────────────
' Private Sub at outer scope is valid when delegate has no ByRef param.
Private Sub CaptureCommand(ByVal CommandID As String, ByVal Context As NameValueMap)
    ' Skip the constant noise commands to keep the log readable
    Select Case CommandID
        Case "AppCancelCmd", "AppDoNothingCmd", "AppUpdateViewCmd",
             "AppOKCmd", "AppPanViewCmd", "AppRotateViewCmd", "AppZoomViewCmd",
             "AppZoomAllViewCmd", "AppZoomWindowCmd"
            Return  ' ignore navigation / generic UI noise
    End Select

    Try
        ' Write to iLogic Logger (visible in the iLogic pane)
        Logger.Info("CMD: " & CommandID)

        ' Write to Desktop log file
        Dim sSentinel As String = SentinelPath()
        If Not System.IO.File.Exists(sSentinel) Then Return
        Dim sLog As String = System.IO.File.ReadAllText(sSentinel).Trim()
        If sLog = "" Then Return
        Dim sLine As String = DateTime.Now.ToString("HH:mm:ss.fff") & "  " & CommandID
        System.IO.File.AppendAllText(sLog, sLine & vbCrLf)
    Catch
    End Try
End Sub

' ══════════════════════════════════════════════════════════════════
Sub Main()
' ══════════════════════════════════════════════════════════════════

    Dim sSentinel As String = SentinelPath()

    ' ── STOP if already running ────────────────────────────────────
    If System.IO.File.Exists(sSentinel) Then
        Try
            Dim sLogPath As String = System.IO.File.ReadAllText(sSentinel).Trim()
            Try
                System.IO.File.AppendAllText(sLogPath,
                    vbCrLf & "=== CAPTURE STOPPED " &
                    DateTime.Now.ToString("HH:mm:ss.fff") & " ===" & vbCrLf)
            Catch : End Try
            System.IO.File.Delete(sSentinel)
            Logger.Info("--- Command capture STOPPED ---")

            Dim oRes As DialogResult = MessageBox.Show(
                "Command capture stopped." & vbCrLf & vbCrLf &
                "Log:" & vbCrLf & sLogPath & vbCrLf & vbCrLf &
                "Open in Notepad now?",
                "CAPTURE STOPPED", MessageBoxButtons.YesNo, MessageBoxIcon.Information)
            If oRes = DialogResult.Yes Then
                Try : System.Diagnostics.Process.Start("notepad.exe", sLogPath) : Catch : End Try
            End If
        Catch ex As Exception
            MessageBox.Show("Stop error: " & ex.Message, "Capture",
                MessageBoxButtons.OK, MessageBoxIcon.Warning)
            Try : System.IO.File.Delete(sSentinel) : Catch : End Try
        End Try
        Return
    End If

    ' ── START capture ──────────────────────────────────────────────
    Dim sTimestamp As String = DateTime.Now.ToString("yyyy-MM-dd_HHmmss")
    Dim sLog As String = System.IO.Path.Combine(
        System.Environment.GetFolderPath(System.Environment.SpecialFolder.Desktop),
        "INVENTOR_COMMAND_CAPTURE_" & sTimestamp & ".log")

    Dim oHdr As New System.Text.StringBuilder()
    oHdr.AppendLine("INVENTOR COMMAND CAPTURE — " & DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))
    oHdr.AppendLine("FORMAT:  HH:mm:ss.fff  CommandID")
    oHdr.AppendLine("Noise commands (pan/zoom/cancel/OK) are filtered out.")
    oHdr.AppendLine("Look for: Replace Component, Update Drawing Reference, Save-related IDs.")
    oHdr.AppendLine(New String("="c, 80))
    oHdr.AppendLine()
    System.IO.File.WriteAllText(sLog, oHdr.ToString())
    ' Sentinel stores the log path so CaptureCommand can find it.
    System.IO.File.WriteAllText(sSentinel, sLog)

    ' ── Hook command events ────────────────────────────────────────
    Try
        Dim oApp As Application = ThisApplication
        AddHandler oApp.CommandManager.CommandEvents.OnCommand, AddressOf CaptureCommand
        Logger.Info("--- Command capture STARTED — " & sLog & " ---")
    Catch exHook As Exception
        System.IO.File.Delete(sSentinel)
        MessageBox.Show("Failed to hook CommandEvents: " & exHook.Message,
            "Capture", MessageBoxButtons.OK, MessageBoxIcon.Error)
        Return
    End Try

    MessageBox.Show(
        "Command capture is ACTIVE." & vbCrLf & vbCrLf &
        "Do your manual operations in Inventor now." & vbCrLf &
        "(Replace Component, Update Drawing Ref, Save, etc.)" & vbCrLf & vbCrLf &
        "Watch the iLogic Logger pane — or open this in Notepad (hit F5 to refresh):" & vbCrLf &
        sLog & vbCrLf & vbCrLf &
        "Run this rule AGAIN to stop.",
        "CAPTURE ACTIVE", MessageBoxButtons.OK, MessageBoxIcon.Information)

End Sub
