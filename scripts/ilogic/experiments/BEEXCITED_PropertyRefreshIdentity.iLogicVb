' BEEXCITED Property Refresh 01 — pure canonical identity decision v0.1.0
' Decision ONLY. Caller supplies independently resolved Windows filesystem evidence.
' Never authorizes APPLY by itself: Vault ownership, dirty/read-only state and persisted
' reopen/readback remain separate mandatory gates. No Inventor, Vault, UI or writes.
Imports System
Imports System.Collections.Generic
Imports System.IO

Public Module BEEXCITED_PropertyRefreshIdentity
    Public Const IdentityVersion As String = "0.1.0"
    Public Enum IdentityReason
        DenyMissingEvidence
        DenyInvalidIdentity
        DenyChangedIdentity
        DenySourceRoot
        DenyOutsideTarget
        DenyProtectedRoot
        EligibleIdentityOnly
    End Enum

    Public Class IdentityEvidence
        Public OriginalPath As String
        Public ResolvedPath As String
        Public ResolvedSourceRoot As String
        Public ResolvedTargetRoot As String
        Public ResolvedProtectedRoots As IEnumerable(Of String)
        Public ResolutionSucceeded As Boolean
        Public IsReparseAmbiguous As Boolean
        Public StableFileId As String
        Public RecheckedFileId As String
    End Class

    Private Function NormalizedAbsolute(ByVal value As String) As String
        If String.IsNullOrWhiteSpace(value) Then Return Nothing
        Try
            If Not Path.IsPathRooted(value) Then Return Nothing
            Dim full As String = Path.GetFullPath(value)
            Dim root As String = Path.GetPathRoot(full)
            If String.IsNullOrWhiteSpace(root) Then Return Nothing
            If String.Equals(full, root, StringComparison.OrdinalIgnoreCase) Then Return root
            Return full.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
        Catch
            Return Nothing
        End Try
    End Function

    Private Function IsUnder(ByVal candidate As String, ByVal root As String) As Boolean
        If candidate Is Nothing OrElse root Is Nothing Then Return False
        If String.Equals(candidate, root, StringComparison.OrdinalIgnoreCase) Then Return True
        Dim separator As String = If(root.EndsWith(Path.DirectorySeparatorChar.ToString()), "", Path.DirectorySeparatorChar.ToString())
        Return candidate.StartsWith(root & separator, StringComparison.OrdinalIgnoreCase)
    End Function

    ' All paths MUST already be canonical filesystem-resolved identities, not lexical guesses.
    ' This pure function cannot prove the adapter actually performed canonical resolution.
    Public Function EvaluateApplyIdentity(ByVal evidence As IdentityEvidence) As IdentityReason
        If evidence Is Nothing OrElse Not evidence.ResolutionSucceeded OrElse evidence.IsReparseAmbiguous OrElse evidence.ResolvedProtectedRoots Is Nothing Then
            Return IdentityReason.DenyMissingEvidence
        End If
        Dim original As String = NormalizedAbsolute(evidence.OriginalPath)
        Dim candidate As String = NormalizedAbsolute(evidence.ResolvedPath)
        Dim source As String = NormalizedAbsolute(evidence.ResolvedSourceRoot)
        Dim target As String = NormalizedAbsolute(evidence.ResolvedTargetRoot)
        If original Is Nothing OrElse candidate Is Nothing OrElse source Is Nothing OrElse target Is Nothing Then Return IdentityReason.DenyInvalidIdentity
        If String.IsNullOrWhiteSpace(evidence.StableFileId) OrElse String.IsNullOrWhiteSpace(evidence.RecheckedFileId) Then Return IdentityReason.DenyMissingEvidence
        If Not String.Equals(evidence.StableFileId, evidence.RecheckedFileId, StringComparison.Ordinal) Then Return IdentityReason.DenyChangedIdentity
        If IsUnder(candidate, source) Then Return IdentityReason.DenySourceRoot
        If Not IsUnder(candidate, target) Then Return IdentityReason.DenyOutsideTarget
        For Each raw As String In evidence.ResolvedProtectedRoots
            Dim protectedRoot As String = NormalizedAbsolute(raw)
            If protectedRoot Is Nothing Then Return IdentityReason.DenyInvalidIdentity
            If IsUnder(candidate, protectedRoot) Then Return IdentityReason.DenyProtectedRoot
        Next
        Return IdentityReason.EligibleIdentityOnly
    End Function
End Module
